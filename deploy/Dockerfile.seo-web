# Sitio publico (Next.js): paginas de celebracion, enlaces personales de RSVP y catalogo de proveedores.
# Build desde la raiz del repo: docker build -f deploy/Dockerfile.seo-web .
# NEXT_PUBLIC_* se incrustan al compilar: cambiarlas exige reconstruir la imagen.
FROM node:24.18.1-bookworm-slim
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=--max-old-space-size=3072
WORKDIR /workspace
RUN corepack enable && corepack prepare yarn@4.10.3 --activate
COPY . .
RUN yarn install --immutable
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
RUN yarn workspace @rsvp/seo-web build
ENV NODE_ENV=production
WORKDIR /workspace/apps/seo-web
EXPOSE 3000
USER node
CMD ["yarn", "next", "start", "-p", "3000", "-H", "0.0.0.0"]
