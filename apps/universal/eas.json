{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "base": {
      "corepack": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://rsvp-api.161.97.85.216.sslip.io",
        "EXPO_PUBLIC_SITE_URL": "https://rsvp-web.161.97.85.216.sslip.io",
        "EXPO_PUBLIC_RSVP_ORIGIN": "https://dev.done.arauzsoftware.com"
      }
    },
    "development": { "extends": "base", "developmentClient": true, "distribution": "internal", "channel": "development" },
    "preview": { "extends": "base", "distribution": "internal", "channel": "preview", "android": { "buildType": "apk" }, "ios": { "simulator": false } },
    "simulator": { "extends": "production", "distribution": "internal", "autoIncrement": false, "ios": { "simulator": true } },
    "production": { "extends": "base", "autoIncrement": true, "channel": "production" }
  },
  "submit": { "production": { "android": { "track": "internal" } } }
}
