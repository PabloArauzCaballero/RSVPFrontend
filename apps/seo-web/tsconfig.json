{
  "extends": "@rsvp/config-ts/base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "incremental": true,
    "allowJs": true,
    "noEmit": true
  },
  "include": [
    ".next-e2e/types/**/*.ts",
    ".next-f10-fx/types/**/*.ts",
    ".next-f10/types/**/*.ts",
    ".next-f22/types/**/*.ts",
    ".next/types/**/*.ts",
    "app",
    "next-env.d.ts",
    "tests",
    ".next-live/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
