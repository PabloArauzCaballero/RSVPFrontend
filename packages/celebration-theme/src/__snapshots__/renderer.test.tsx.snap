exports[`CelebrationRenderer > REQ-F09-01/03 · festive layout, light and dark > light 1`] = `"<link rel="preload" as="image" href="https://media.test/g1-full.webp" fetchPriority="high"/><article class="celebration" data-layout="festive" data-color-scheme="light" data-section-style="cards" data-divider="none" data-align="center" data-heading-case="none" data-images="rounded" lang="es-BO" style="--celebration-canvas:#FFF5FA;--celebration-surface:#FFFFFF;--celebration-text:#2B1730;--celebration-accent:#C2185B;--celebration-accent-fill:#C2185B;--celebration-on-accent:#FFFFFF;--celebration-art-disc:#F4EAF0;--celebration-art-shadow:#EADFE6;--celebration-art-ink:#2B1730;--celebration-art-cutout:#FFF5FA;--celebration-art-secondary:#928392;--celebration-art-accent:#C2185B;--celebration-muted:#6E5672;--celebration-heading-font:&#x27;Fredoka&#x27;, &#x27;Trebuchet MS&#x27;, sans-serif;--celebration-body-font:&#x27;Nunito&#x27;, Arial, sans-serif;--celebration-radius:20px;--celebration-gap:32px;--celebration-max-width:880px;--celebration-heading-scale:1.3"><div class="cdesign-dock rsvp-protected" role="group" aria-label="celebration.dock.label" data-dock=""><a class="celebration-cta" href="/c/ana-y-luis/regalos" data-link-kind="internal" data-action="gifts" data-dock=""><svg class="celebration-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" data-icon="gifts"><rect x="3.5" y="8" width="17" height="4" rx="1"></rect><path d="M5 12 V19 A1 1 0 0 0 6 20 H18 A1 1 0 0 0 19 19 V12"></path><path d="M12 8 V20"></path><path d="M12 8 C10 8 8 7.2 8 5.8 C8 4.6 9.2 4.2 10.2 4.8 C11.2 5.4 12 8 12 8 C12 8 12.8 5.4 13.8 4.8 C14.8 4.2 16 4.6 16 5.8 C16 7.2 14 8 12 8"></path></svg><span>celebration.gifts.cta</span></a></div><header class="celebration-hero" data-hero="banner" data-has-image="true"><img class="celebration-hero-image" src="https://media.test/g1-ful