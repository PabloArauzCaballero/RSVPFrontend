{
  "openapi": "3.1.0",
  "info": {
    "title": "RSVP Identity API",
    "version": "1.3.0",
    "description": "1.3.0 (additive, B4): real password recovery and e-mail verification. POST /auth/password-recovery now stores a single-use token (30 minutes, hash only) and asks Notification to send the link (event identity.user.password-reset-requested.v1); POST /auth/password-reset consumes it, sets the new password and ends every session; sign-up sends a 24-hour verification link (identity.user.email-verification-requested.v1), confirmed with POST /auth/email-verification/confirm and re-sent with POST /auth/email-verification. Registration and the access token expose whether the e-mail is verified (`emailVerified`, claim `email_verified`). 1.2.0 (additive, B9): the access token carries `memberships` [{organizationId, role}], the role of the subject IN each organization. `roles` now lists only the platform roles of the account (membership roles are no longer merged into it); `organizationIds` stays, derived from `memberships`, for visibility only. Consumers decide organization-scoped authority from `memberships` and must treat a token without it (minted by Identity < 1.2.0) as granting no organization management. 1.1.0 (additive, ADMIN only): GET /admin/users?query=&page=&size=, GET /admin/organizations and GET /admin/summary (served by Kong at /identity/admin/*). Reads of the user list and role grants are audited (actor, action, time; never the search text). Account status is always ACTIVE: suspension of accounts does not exist yet."
  },
  "servers": [
    {
      "url": "http://localhost:8000/identity"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "identityHealth",
        "responses": {
          "200": {
            "description": "Healthy"
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "operationId": "registerUser",
        "responses": {
          "201": {
            "description": "Registered and signed in",
            "headers": {
              "Set-Cookie": {
                "description": "`rsvp_refresh` cookie when `X-Session-Transport: cookie` is sent; cleared (Max-Age=0) on logout.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Registration"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/SessionTransport"
          },
          {
            "$ref": "#/components/parameters/AcceptLanguage"
          }
        ]
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "login",
        "responses": {
          "200": {
            "description": "Session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "description": "`rsvp_refresh` cookie when `X-Session-Transport: cookie` is sent; cleared (Max-Age=0) on logout.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/SessionTransport"
          }
        ]
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "refreshSession",
        "responses": {
          "200": {
            "description": "Rotated session. Reusing a consumed refresh token revokes its whole chain and returns 401.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "description": "`rsvp_refresh` cookie when `X-Session-Transport: cookie` is sent; cleared (Max-Age=0) on logout.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/Validation",
            "description": null
          }
        },
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "description": "Required unless `X-Session-Transport: cookie`, in which case the body is ignored and the cookie is used (401 when the cookie is absent or revoked)."
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/SessionTransport"
          }
        ]
      }
    },
    "/auth/password-recovery": {
      "post": {
        "operationId": "requestPasswordRecovery",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordRecoveryRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted. This response is identical whether or not the account exists."
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          }
        },
        "description": "Always 202 for a well-formed address. For an existing account, stores the SHA-256 of a single-use token valid 30 minutes (any earlier unused link stops working) and records the e-mail request for Notification. A second request within 60 seconds sends nothing new. `Accept-Language` picks the e-mail language (en-US or es-BO).",
        "parameters": [
          {
            "$ref": "#/components/parameters/AcceptLanguage"
          }
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogoutRequest"
              }
            }
          },
          "description": "Required unless `X-Session-Transport: cookie`, in which case the body is ignored and the cookie is used."
        },
        "responses": {
          "204": {
            "description": "Refresh-token chain revoked",
            "headers": {
              "Set-Cookie": {
                "description": "`rsvp_refresh` cookie when `X-Session-Transport: cookie` is sent; cleared (Max-Age=0) on logout.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/SessionTransport"
          }
        ]
      }
    },
    "/.well-known/jwks.json": {
      "get": {
        "operationId": "jwks",
        "responses": {
          "200": {
            "description": "JWKS (RFC 7517). kid is the RFC 7638 thumbprint.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Jwks"
                }
              }
            }
          }
        }
      }
    },
    "/organizations": {
      "post": {
        "operationId": "createOrganization",
        "summary": "Create an organization; the caller becomes its owner and a PLANNER member (needs MANAGE_ORGANIZATION: PLANNER or ADMIN)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrganizationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Organization"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          }
        }
      },
      "get": {
        "operationId": "listOrganizations",
        "summary": "Organizations the caller belongs to (ADMIN: all)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Organizations",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/OrganizationSummary"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/organizations/{id}": {
      "get": {
        "operationId": "getOrganization",
        "summary": "Read an organization with its members (members and ADMIN only)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The organization",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Organization"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/organizations/{id}/members": {
      "post": {
        "operationId": "addOrganizationMember",
        "summary": "Add an existing account as HOST or PLANNER member (owner or ADMIN). The member's next access token lists the organization.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddMemberRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Member added",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganizationMember"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          }
        }
      }
    },
    "/users": {
      "get": {
        "operationId": "listUsers",
        "summary": "List accounts, paginated (ADMIN only)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of users",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserPage"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "operationId": "getUser",
        "summary": "Read one account (ADMIN only)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/users/{id}/roles/{role}": {
      "put": {
        "operationId": "grantUserRole",
        "summary": "Grant a platform role, idempotent (ADMIN only). The first ADMIN comes from the operator command IDENTITY_BOOTSTRAP_ADMIN_EMAIL",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "role",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "ADMIN",
                "HOST",
                "PLANNER",
                "PROVIDER"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The user with its roles",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          }
        }
      }
    },
    "/admin/users": {
      "get": {
        "operationId": "adminListUsers",
        "summary": "Accounts, optionally filtered by an e-mail fragment",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUserPage"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          }
        },
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": false,
            "description": "Case-insensitive e-mail fragment, up to 120 characters",
            "schema": {
              "type": "string",
              "maxLength": 120
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Zero-based page",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "description": "1..100, default 50",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ]
      }
    },
    "/admin/organizations": {
      "get": {
        "operationId": "adminListOrganizations",
        "summary": "Every organization with its members",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AdminOrganization"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/admin/summary": {
      "get": {
        "operationId": "adminSummary",
        "summary": "Account and organization counts",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminSummary"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/auth/password-reset": {
      "post": {
        "operationId": "resetPassword",
        "description": "Consumes the single-use link of a password-recovery e-mail, sets the new password, marks the e-mail verified and revokes every refresh-token chain of the account (signs it out everywhere). Unknown, used or expired links answer 422 on `token`; a weak password answers 422 on `newPassword` without consuming the link.",
        "parameters": [
          {
            "$ref": "#/components/parameters/SessionTransport"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Password changed; every session ended.",
            "headers": {
              "Set-Cookie": {
                "description": "Cleared `rsvp_refresh` cookie (Max-Age=0) when `X-Session-Transport: cookie` is sent.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          }
        }
      }
    },
    "/auth/email-verification/confirm": {
      "post": {
        "operationId": "confirmEmailVerification",
        "description": "Consumes the single-use link of the verification e-mail (24 hours) and marks the account's e-mail verified. Unknown, used or expired links answer 422 on `token`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailVerificationConfirmRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "E-mail verified."
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          }
        }
      }
    },
    "/auth/email-verification": {
      "post": {
        "operationId": "resendEmailVerification",
        "description": "Sends a new verification link to the signed-in account. No-op (still 202) when the e-mail is already verified or a link was sent less than 60 seconds ago.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/AcceptLanguage"
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "field",
                "message"
              ],
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "PasswordRecoveryRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 320
          }
        }
      },
      "LogoutRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "refreshToken"
        ],
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 32,
            "maxLength": 4096
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 320
          },
          "password": {
            "type": "string",
            "maxLength": 128
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 320
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "description": "Length-based policy; at most 72 UTF-8 bytes."
          },
          "role": {
            "type": "string",
            "enum": [
              "HOST",
              "PLANNER",
              "PROVIDER"
            ],
            "default": "HOST",
            "description": "ADMIN is never self-service."
          }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "required": [
          "refreshToken"
        ],
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 32,
            "maxLength": 4096
          }
        }
      },
      "Session": {
        "type": "object",
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn"
        ],
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "RS256 JWT. Claims: iss, sub, roles[] (platform roles), organizationIds[], memberships[] ({organizationId, role}), iat, exp, jti."
          },
          "refreshToken": {
            "type": "string",
            "description": "Opaque, single use, 30 days. Omitted when `X-Session-Transport: cookie` (it is in the httpOnly cookie)."
          },
          "tokenType": {
            "const": "Bearer"
          },
          "expiresIn": {
            "type": "integer",
            "const": 900
          }
        }
      },
      "Registration": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Session"
          },
          {
            "type": "object",
            "required": [
              "id",
              "email",
              "roles"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "HOST",
                    "PLANNER",
                    "PROVIDER"
                  ]
                }
              },
              "emailVerified": {
                "type": "boolean",
                "description": "Since 1.3.0. Always false right after sign-up: a verification e-mail is on its way."
              }
            }
          }
        ]
      },
      "Jwks": {
        "type": "object",
        "required": [
          "keys"
        ],
        "properties": {
          "keys": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kty",
                "kid",
                "use",
                "alg",
                "n",
                "e"
              ],
              "properties": {
                "kty": {
                  "const": "RSA"
                },
                "kid": {
                  "type": "string"
                },
                "use": {
                  "const": "sig"
                },
                "alg": {
                  "const": "RS256"
                },
                "n": {
                  "type": "string"
                },
                "e": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "AccessTokenClaims": {
        "type": "object",
        "description": "Payload of accessToken, consumed by every service. Organization-scoped authority comes only from `memberships`.",
        "required": [
          "iss",
          "sub",
          "roles",
          "organizationIds",
          "iat",
          "exp"
        ],
        "properties": {
          "iss": {
            "type": "string"
          },
          "sub": {
            "type": "string",
            "format": "uuid"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ADMIN",
                "HOST",
                "PLANNER",
                "PROVIDER"
              ]
            },
            "description": "Platform roles of the account. Never contains roles held in an organization (see `memberships`)."
          },
          "organizationIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Organizations the subject belongs to in any role (derived from `memberships`). Visibility only: never a source of authority."
          },
          "memberships": {
            "type": "array",
            "description": "Since 1.2.0. The role of the subject in each organization it belongs to. A role here applies only to its organization.",
            "items": {
              "$ref": "#/components/schemas/OrganizationMembershipClaim"
            }
          },
          "iat": {
            "type": "integer"
          },
          "exp": {
            "type": "integer"
          },
          "jti": {
            "type": "string",
            "format": "uuid"
          },
          "email_verified": {
            "type": "boolean",
            "description": "Since 1.3.0. Whether the account proved it owns its e-mail."
          }
        }
      },
      "CreateOrganizationRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      },
      "AddMemberRequest": {
        "type": "object",
        "required": [
          "email",
          "role"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "HOST",
              "PLANNER"
            ]
          }
        }
      },
      "OrganizationMember": {
        "type": "object",
        "required": [
          "userId",
          "role"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Absent in the creation response"
          },
          "role": {
            "type": "string",
            "enum": [
              "HOST",
              "PLANNER"
            ]
          }
        }
      },
      "Organization": {
        "type": "object",
        "required": [
          "id",
          "name",
          "ownerUserId",
          "members"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "ownerUserId": {
            "type": "string",
            "format": "uuid"
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrganizationMember"
            }
          }
        }
      },
      "OrganizationSummary": {
        "type": "object",
        "required": [
          "id",
          "name",
          "ownerUserId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "ownerUserId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "email",
          "roles"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ADMIN",
                "HOST",
                "PLANNER",
                "PROVIDER"
              ]
            }
          },
          "createdAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "UserPage": {
        "type": "object",
        "required": [
          "items",
          "page",
          "size",
          "total"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/User"
            }
          },
          "page": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "AdminUser": {
        "type": "object",
        "required": [
          "id",
          "email",
          "roles",
          "status",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "SUSPENDED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AdminUserPage": {
        "type": "object",
        "required": [
          "items",
          "page",
          "size",
          "total"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminUser"
            }
          },
          "page": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "AdminOrganization": {
        "type": "object",
        "required": [
          "id",
          "name",
          "ownerUserId",
          "members"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "ownerUserId": {
            "type": "string",
            "format": "uuid"
          },
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "userId",
                "email",
                "role"
              ],
              "properties": {
                "userId": {
                  "type": "string",
                  "format": "uuid"
                },
                "email": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "AdminSummary": {
        "type": "object",
        "required": [
          "users",
          "organizations"
        ],
        "properties": {
          "users": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer"
              },
              "byRole": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                }
              }
            }
          },
          "organizations": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer"
              }
            }
          }
        }
      },
      "OrganizationMembershipClaim": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "organizationId",
          "role"
        ],
        "properties": {
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "HOST",
              "PLANNER"
            ]
          }
        }
      },
      "PasswordResetRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "token",
          "newPassword"
        ],
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "The `token` query parameter of the e-mail link."
          },
          "newPassword": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          }
        }
      },
      "EmailVerificationConfirmRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Authentication failed",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Conflict": {
        "description": "Resource conflict",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Validation": {
        "description": "Validation failed",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Authenticated, but the role or membership does not allow this",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "NotFound": {
        "description": "Unknown organization, or one the caller does not belong to (indistinguishable by design)",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "SessionTransport": {
        "name": "X-Session-Transport",
        "in": "header",
        "required": false,
        "description": "`cookie` (web): the refresh token travels only in the `rsvp_refresh` cookie (HttpOnly, Secure, SameSite=Strict, Path=/identity/auth, 30 days) and is omitted from bodies. Absent (mobile): the refresh token is in the body. The custom header forces a CORS preflight, which with SameSite=Strict is the CSRF defence.",
        "schema": {
          "type": "string",
          "enum": [
            "cookie"
          ]
        }
      },
      "AcceptLanguage": {
        "name": "Accept-Language",
        "in": "header",
        "required": false,
        "description": "Language of the account e-mail: en-US when it starts with `en`, es-BO otherwise.",
        "schema": {
          "type": "string"
        }
      }
    }
  }
}
