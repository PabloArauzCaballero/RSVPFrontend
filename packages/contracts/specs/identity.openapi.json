{
  "openapi": "3.1.0",
  "info": {
    "title": "RSVP Identity API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8000/identity"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "identityHealth",
        "responses": {
          "200": {
            "description": "Healthy"
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "operationId": "registerUser",
        "responses": {
          "201": {
            "description": "Registered and signed in",
            "headers": {
              "Set-Cookie": {
                "description": "`rsvp_refresh` cookie when `X-Session-Transport: cookie` is sent; cleared (Max-Age=0) on logout.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Registration"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/SessionTransport"
          }
        ]
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "login",
        "responses": {
          "200": {
            "description": "Session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "description": "`rsvp_refresh` cookie when `X-Session-Transport: cookie` is sent; cleared (Max-Age=0) on logout.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/SessionTransport"
          }
        ]
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "refreshSession",
        "responses": {
          "200": {
            "description": "Rotated session. Reusing a consumed refresh token revokes its whole chain and returns 401.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "description": "`rsvp_refresh` cookie when `X-Session-Transport: cookie` is sent; cleared (Max-Age=0) on logout.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/Validation",
            "description": null
          }
        },
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "description": "Required unless `X-Session-Transport: cookie`, in which case the body is ignored and the cookie is used (401 when the cookie is absent or revoked)."
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/SessionTransport"
          }
        ]
      }
    },
    "/auth/password-recovery": {
      "post": {
        "operationId": "requestPasswordRecovery",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordRecoveryRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted. This response is identical whether or not the account exists."
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogoutRequest"
              }
            }
          },
          "description": "Required unless `X-Session-Transport: cookie`, in which case the body is ignored and the cookie is used."
        },
        "responses": {
          "204": {
            "description": "Refresh-token chain revoked",
            "headers": {
              "Set-Cookie": {
                "description": "`rsvp_refresh` cookie when `X-Session-Transport: cookie` is sent; cleared (Max-Age=0) on logout.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/SessionTransport"
          }
        ]
      }
    },
    "/.well-known/jwks.json": {
      "get": {
        "operationId": "jwks",
        "responses": {
          "200": {
            "description": "JWKS (RFC 7517). kid is the RFC 7638 thumbprint.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Jwks"
                }
              }
            }
          }
        }
      }
    },
    "/organizations": {
      "post": {
        "operationId": "createOrganization",
        "summary": "Create an organization; the caller becomes its owner and a PLANNER member (needs MANAGE_ORGANIZATION: PLANNER or ADMIN)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrganizationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Organization"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          }
        }
      },
      "get": {
        "operationId": "listOrganizations",
        "summary": "Organizations the caller belongs to (ADMIN: all)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Organizations",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/OrganizationSummary"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/organizations/{id}": {
      "get": {
        "operationId": "getOrganization",
        "summary": "Read an organization with its members (members and ADMIN only)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The organization",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Organization"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/organizations/{id}/members": {
      "post": {
        "operationId": "addOrganizationMember",
        "summary": "Add an existing account as HOST or PLANNER member (owner or ADMIN). The member's next access token lists the organization.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddMemberRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Member added",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganizationMember"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          }
        }
      }
    },
    "/users": {
      "get": {
        "operationId": "listUsers",
        "summary": "List accounts, paginated (ADMIN only)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of users",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserPage"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "operationId": "getUser",
        "summary": "Read one account (ADMIN only)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/users/{id}/roles/{role}": {
      "put": {
        "operationId": "grantUserRole",
        "summary": "Grant a platform role, idempotent (ADMIN only). The first ADMIN comes from the operator command IDENTITY_BOOTSTRAP_ADMIN_EMAIL",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "role",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "ADMIN",
                "HOST",
                "PLANNER",
                "PROVIDER"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The user with its roles",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "field",
                "message"
              ],
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "PasswordRecoveryRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 320
          }
        }
      },
      "LogoutRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "refreshToken"
        ],
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 32,
            "maxLength": 4096
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 320
          },
          "password": {
            "type": "string",
            "maxLength": 128
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 320
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "description": "Length-based policy; at most 72 UTF-8 bytes."
          },
          "role": {
            "type": "string",
            "enum": [
              "HOST",
              "PLANNER",
              "PROVIDER"
            ],
            "default": "HOST",
            "description": "ADMIN is never self-service."
          }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "required": [
          "refreshToken"
        ],
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 32,
            "maxLength": 4096
          }
        }
      },
      "Session": {
        "type": "object",
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn"
        ],
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "RS256 JWT. Claims: iss, sub, roles[], organizationIds[], iat, exp, jti."
          },
          "refreshToken": {
            "type": "string",
            "description": "Opaque, single use, 30 days. Omitted when `X-Session-Transport: cookie` (it is in the httpOnly cookie)."
          },
          "tokenType": {
            "const": "Bearer"
          },
          "expiresIn": {
            "type": "integer",
            "const": 900
          }
        }
      },
      "Registration": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Session"
          },
          {
            "type": "object",
            "required": [
              "id",
              "email",
              "roles"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "HOST",
                    "PLANNER",
                    "PROVIDER"
                  ]
                }
              }
            }
          }
        ]
      },
      "Jwks": {
        "type": "object",
        "required": [
          "keys"
        ],
        "properties": {
          "keys": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kty",
                "kid",
                "use",
                "alg",
                "n",
                "e"
              ],
              "properties": {
                "kty": {
                  "const": "RSA"
                },
                "kid": {
                  "type": "string"
                },
                "use": {
                  "const": "sig"
                },
                "alg": {
                  "const": "RS256"
                },
                "n": {
                  "type": "string"
                },
                "e": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "AccessTokenClaims": {
        "type": "object",
        "description": "Payload of accessToken, consumed by every service.",
        "required": [
          "iss",
          "sub",
          "roles",
          "organizationIds",
          "iat",
          "exp"
        ],
        "properties": {
          "iss": {
            "type": "string"
          },
          "sub": {
            "type": "string",
            "format": "uuid"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ADMIN",
                "HOST",
                "PLANNER",
                "PROVIDER"
              ]
            }
          },
          "organizationIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "iat": {
            "type": "integer"
          },
          "exp": {
            "type": "integer"
          },
          "jti": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CreateOrganizationRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      },
      "AddMemberRequest": {
        "type": "object",
        "required": [
          "email",
          "role"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "HOST",
              "PLANNER"
            ]
          }
        }
      },
      "OrganizationMember": {
        "type": "object",
        "required": [
          "userId",
          "role"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Absent in the creation response"
          },
          "role": {
            "type": "string",
            "enum": [
              "HOST",
              "PLANNER"
            ]
          }
        }
      },
      "Organization": {
        "type": "object",
        "required": [
          "id",
          "name",
          "ownerUserId",
          "members"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "ownerUserId": {
            "type": "string",
            "format": "uuid"
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrganizationMember"
            }
          }
        }
      },
      "OrganizationSummary": {
        "type": "object",
        "required": [
          "id",
          "name",
          "ownerUserId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "ownerUserId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "email",
          "roles"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ADMIN",
                "HOST",
                "PLANNER",
                "PROVIDER"
              ]
            }
          },
          "createdAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "UserPage": {
        "type": "object",
        "required": [
          "items",
          "page",
          "size",
          "total"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/User"
            }
          },
          "page": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Authentication failed",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Conflict": {
        "description": "Resource conflict",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Validation": {
        "description": "Validation failed",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Authenticated, but the role or membership does not allow this",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "NotFound": {
        "description": "Unknown organization, or one the caller does not belong to (indistinguishable by design)",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "SessionTransport": {
        "name": "X-Session-Transport",
