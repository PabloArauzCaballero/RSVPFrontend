{
  "name": "@rsvp/design-tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tailwind-preset": "./tailwind-preset.cjs",
    "./tailwind-preset-native": "./tailwind-preset-native.cjs",
