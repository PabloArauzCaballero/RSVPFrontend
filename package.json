{
  "name": "rsvp-frontend",
  "private": true,
  "packageManager": "yarn@4.10.3",
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "eslint . --max-warnings 0 && turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev --parallel",
    "verify": "yarn build && yarn lint && yarn test && yarn typecheck",
    "harness:validate": "node scripts/validate-harness.mjs",
    "graph:init": "codegraph init --yes",
    "graph:status": "codegraph status",
    "graph:sync": "codegraph sync",
    "graph:probe": "node scripts/probe-codegraph-mcp.mjs",
    "lint:code": "eslint . --max-warnings 0",
    "hooks:install": "git config core.hooksPath .githooks",
    "test:coverage": "turbo run test:coverage",
    "assets:generate": "node scripts/generate-brand-assets.mjs",
    "assets:check": "node scripts/generate-brand-assets.mjs --check"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@colbymchenry/codegraph": "1.6.2",
    "@playwright/test": "1.62.1",
    "@types/node": "22.15.3",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.25.1",
    "lighthouse": "12.8.2",
    "playwright": "1.62.1",
    "prettier": "3.5.3",
    "turbo": "2.5.2",
    "typescript": "5.8.3",
    "vitest": "3.1.2"
  }
}
